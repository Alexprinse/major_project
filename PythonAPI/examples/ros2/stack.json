{
    "type": "vehicle.lincoln.mkz_2017",
    "id": "hero",

    "vehicle_ros_publish_tf": true,
    "vehicle_ros_frame_id": "base_link",
    "sensor_ros_frame_id": "base_link",

    "sensors": [

        {
            "type": "sensor.camera.rgb",
            "id": "rgb_front",
            "spawn_point": {"x": 1.5, "y": 0.0, "z": 2.0, "roll": 0.0, "pitch": 0.0, "yaw": 0.0},
            "attributes": {
                "image_size_x": 1280,
                "image_size_y": 720,
                "fov": 90.0,
                "ros_publish_tf": true
            }
        },

        {
            "type": "sensor.camera.depth",
            "id": "depth_front",
            "spawn_point": {"x": 1.5, "y": 0.0, "z": 2.0, "roll": 0.0, "pitch": 0.0, "yaw": 0.0},
            "attributes": {
                "image_size_x": 1280,
                "image_size_y": 720,
                "fov": 90.0,
                "ros_publish_tf": true
            }
        },

        {
            "type": "sensor.camera.semantic_segmentation",
            "id": "semantic_segmentation_front",
            "spawn_point": {"x": 1.5, "y": 0.0, "z": 2.0, "roll": 0.0, "pitch": 0.0, "yaw": 0.0},
            "attributes": {
                "image_size_x": 1280,
                "image_size_y": 720,
                "fov": 90.0,
                "ros_publish_tf": true
            }
        },

        {
            "type": "sensor.camera.rgb",
            "id": "ego_view",
            "spawn_point": {"x": -4.5, "y": 0.0, "z": 2.5, "roll": 0.0, "pitch": 15.0, "yaw": 0.0},
